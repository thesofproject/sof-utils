# Android init service for SOF Remote Telemetry & Debug Server (opt-in on debuggable builds)

service vendor.sof_remote_server /vendor/bin/sof_remote_server -b 127.0.0.1 -p 9998
    class late_start
    user root
    group root audio system
    disabled

on property:persist.vendor.sof.remote_server.enable=1 && property:ro.debuggable=1
    start vendor.sof_remote_server

on property:persist.vendor.sof.remote_server.enable=0
    stop vendor.sof_remote_server
