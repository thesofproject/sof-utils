    def _on_mode_btn_bind(self, _factory, list_item: Gtk.ListItem):
        item = list_item.get_item()
        lbl = list_item.get_child()
        if item and lbl:
            lbl.set_text(item.label)
            if item.tooltip:
                lbl.set_tooltip_text(item.tooltip)

    def _on_mode_list_bind(self, _factory, list_item: Gtk.ListItem):
        item = list_item.get_item()
        lbl = list_item.get_child()
        if item and lbl:
            lbl.set_text(item.label)
            lbl.set_sensitive(item.enabled)
            if item.tooltip:
                lbl.set_tooltip_text(item.tooltip)
        if item and hasattr(list_item, "set_selectable"):
            list_item.set_selectable(item.enabled)
        if item and hasattr(list_item, "set_activatable"):
            list_item.set_activatable(item.enabled)

    def _selected_mode_key(self) -> str:
        idx = self.mode_dropdown.get_selected()
        item = self.mode_store.get_item(idx) if idx != Gtk.INVALID_LIST_POSITION else None
        return item.key if item else "remote"

    def _sync_target_widgets(self):
        is_remote = self._selected_mode_key() == "remote"
        self.target_entry.set_sensitive(is_remote)
        if hasattr(self, "target_hist_btn"):
            self.target_hist_btn.set_sensitive(is_remote and bool(self.remote_history))
        self.btn_conn.set_label("Connect" if is_remote else "Refresh")

    def _refresh_remote_history_popover(self):
        self.remote_history = _load_remote_history()
        child = self.history_list_box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.history_list_box.remove(child)
            child = nxt
        for host in self.remote_history:
            btn = Gtk.Button(label=host)
            btn.set_halign(Gtk.Align.FILL)
            btn.add_css_class("flat")
            lbl = btn.get_child()
            if isinstance(lbl, Gtk.Label):
                lbl.set_xalign(0.0)
            btn.connect("clicked", self._on_pick_history_host, host)
            self.history_list_box.append(btn)
        if hasattr(self, "target_hist_btn"):
            self.target_hist_btn.set_sensitive(
                self._selected_mode_key() == "remote" and bool(self.remote_history)
            )

    def _on_pick_history_host(self, _btn, host: str):
        self.history_popover.popdown()
        self.target_entry.set_text(host)
        if self._selected_mode_key() != "remote":
            self._suppress_mode_signal = True
            self.mode_dropdown.set_selected(1)
            self._suppress_mode_signal = False
            self._sync_target_widgets()
        self._connect_backend(host)

    def _remember_remote_host(self, target: str) -> bool:
        self.remote_history = _record_remote_history(target)
        self._refresh_remote_history_popover()
        return False

    def _sync_pm_buttons(
        self,
        read_only: bool,
        connected: Optional[bool] = None,
        snap: Optional[TelemetrySnapshot] = None,
    ):
        if connected is None:
            connected = snap.connected if snap is not None else (self.backend is not None)

        if not connected or read_only:
            self.btn_wake.set_sensitive(False)
            self.btn_hold_d0.set_sensitive(False)
            if not connected and not read_only and self.backend is not None:
                tip = "Target disconnected"
            elif self.backend is None:
                tip = "No target connected"
            else:
                tip = "Read-only local DebugFS/SysFS mode (PM control unavailable)"
            self.btn_wake.set_tooltip_text(tip)
            self.btn_hold_d0.set_tooltip_text(tip)
            if not connected and self.btn_hold_d0.get_active():
                self._suppress_hold_signal = True
                self.btn_hold_d0.set_active(False)
                self._suppress_hold_signal = False
            return

        if snap is None:
            self.btn_wake.set_sensitive(False)
            self.btn_hold_d0.set_sensitive(False)
            self.btn_wake.set_tooltip_text("Waiting for DSP state...")
            self.btn_hold_d0.set_tooltip_text("Waiting for DSP state...")
            return

        dsp_awake_booted = bool(snap.pm_runtime_active and snap.fw_state == 7)
        self.btn_wake.set_sensitive(not dsp_awake_booted)
        self.btn_wake.set_tooltip_text(
            "DSP is already booted and active (D0i0)"
            if dsp_awake_booted
            else "Wake DSP to D0i0 and boot firmware"
        )

        # Sync Hold D0i0 toggle state & allow Hold when DSP is active/booted (or already held to allow release)
        if self.btn_hold_d0.get_active() != self.holding_d0:
            self._suppress_hold_signal = True
            self.btn_hold_d0.set_active(self.holding_d0)
            self._suppress_hold_signal = False

        can_hold = dsp_awake_booted or self.holding_d0
        self.btn_hold_d0.set_sensitive(can_hold)
        self.btn_hold_d0.set_tooltip_text(
            "Release D0i0 runtime PM hold"
            if self.holding_d0
            else (
                "Hold DSP in D0i0 (prevent D3 runtime suspend)"
                if dsp_awake_booted
                else "Wake / Boot DSP before holding D0i0"
            )
        )

    def _on_mode_selected(self, _dd, _pspec):
        if self._suppress_mode_signal:
            return
        idx = self.mode_dropdown.get_selected()
        item = self.mode_store.get_item(idx) if idx != Gtk.INVALID_LIST_POSITION else None
        if not item:
            return
        if item.key == "local" and not item.enabled:
            self._suppress_mode_signal = True
            self.mode_dropdown.set_selected(1)
            self._suppress_mode_signal = False
            self._sync_target_widgets()
            self._set_status(item.tooltip or "Local SOF device unavailable")
            return
        self._sync_target_widgets()
        if item.key == "local":
            spec = getattr(self.args, "local", "") or "auto"
            self._connect_backend(f"local:{spec}")
        else:
            host_txt = self.target_entry.get_text().strip()
            self.target_entry.grab_focus()
            if host_txt:
                self._connect_backend(host_txt)
            else:
                self._set_status("Enter remote server host[:port] and click Connect")

    def _on_connect_clicked(self):
        if self._selected_mode_key() == "local":
            spec = getattr(self.args, "local", "") or "auto"
            self._connect_backend(f"local:{spec}")
            return
        host_txt = self.target_entry.get_text().strip()
        if not host_txt:
            self._set_status("Please enter a remote hostname or IP[:port]")
            self.target_entry.grab_focus()
            return
        self._connect_backend(host_txt)

    def _connect_backend(self, target: str):
        self._set_status(f"Connecting to {target}...")

        def _worker():
            with self.io_lock:
                if self.backend:
                    try:
                        self.backend.close()
                    except Exception:
                        pass
                    self.backend = None
                self.perf_meas_initialized = False
                self.holding_d0 = False

                try:
                    new_be = _build_backend_for_target(target, self.args.port)
                    ok = new_be.connect()
                    self.backend = new_be
                    lbl = getattr(new_be, "transport_label", target)
                    ro = bool(getattr(new_be, "is_read_only", False))
                    err_note = getattr(new_be, "last_error", "")
                    GLib.idle_add(self._sync_pm_buttons, ro, ok, None)
                    if ok:
                        if not (target.startswith("local:") or target.startswith("/") or target == "local"):
                            GLib.idle_add(self._remember_remote_host, target)
                        msg = f"Connected: {lbl}" + (f" ({err_note})" if err_note else "")
                        GLib.idle_add(self._set_status, msg)
                        self._poll_once_Async(True)
                    else:
                        msg = f"Failed to connect to {target}" + (f": {err_note}" if err_note else "")
                        GLib.idle_add(self._set_status, msg)
                except Exception as e:
                    GLib.idle_add(
                        self._set_status, f"Connection to '{target}' failed: {e}"
                    )

        threading.Thread(target=_worker, daemon=True).start()

    def _set_status(self, msg: str):
        self.status_label.set_text(msg)
        return False

    def _on_poll_tick(self) -> bool:
        if self.poll_interval_ms <= 0:
            return False
        self._poll_once(False)
        return True

    def _poll_once(self, force_full: bool = False) -> bool:
        self._poll_once_Async(force_full)
        return False

    def _poll_once_Async(self, force_full: bool = False):
        if self.poll_in_flight:
            return
        self.poll_in_flight = True
        full = force_full or self.holding_d0
        wake = self.wake_on_poll

        def _worker():
            try:
                with self.io_lock:
                    be = self.backend
                    if not be:
                        return
                    snap = be.poll_telemetry(force_full=full, wake_dsp=wake)
                    if snap.connected and snap.pm_runtime_active and snap.fw_state == 7:
                        if not self.perf_meas_initialized:
                            st_perf = be.set_perf_measurement_state(2)
                            self.perf_meas_initialized = True
                            if st_perf == 0:
                                snap = be.poll_telemetry(force_full=True, wake_dsp=wake)
                    elif not snap.connected or snap.fw_state != 7:
                        self.perf_meas_initialized = False
                GLib.idle_add(self._apply_snapshot, snap)
            except Exception as e:
                GLib.idle_add(self._set_status, f"Telemetry poll error: {e}")
            finally:
                self.poll_in_flight = False

        threading.Thread(target=_worker, daemon=True).start()

    def _apply_snapshot(self, snap: TelemetrySnapshot) -> bool:
        ro = bool(getattr(self.backend, "is_read_only", False)) if self.backend else True
        if not snap.connected:
            self._sync_pm_buttons(ro, connected=False, snap=snap)
            self._set_status("Target disconnected — retaining last valid telemetry snapshot")
            return False

        self.dashboard.update_snapshot(snap)
        self._sync_pm_buttons(ro, connected=True, snap=snap)
        pstate = "D0i0 (Active)" if snap.pm_runtime_active else "D3 (Sleep)"
        hp_kb, _, hp_tot_kb = UserDashboardRenderer._sram_segment_metrics(snap.hpsram, 128.0)
        lp_kb, _, lp_tot_kb = UserDashboardRenderer._sram_segment_metrics(snap.lpsram, 64.0)
        hp_s = f"{hp_kb:.0f}/{hp_tot_kb:.0f} KB" if hp_tot_kb > 0 else "N/A"
        lp_s = f"{lp_kb:.0f}/{lp_tot_kb:.0f} KB" if lp_tot_kb > 0 else "N/A"
        self._set_status(
            f"[{getattr(self.backend, 'transport_label', 'SOF')}] "
            f"Platform: {snap.platform} | FW: v{snap.fw_version} ({snap.fw_state_name}) | "
            f"Power: {pstate} | Cores: 0x{snap.enabled_cores_mask:x}/{snap.num_cores} | "
            f"HPSRAM: {hp_s} | LPSRAM: {lp_s} | "
            f"DRAM (L3/IMR): {snap.dram_used_kb:,.0f}/{snap.dram_total_kb:,.0f} KB | "
            f"Tasks: {len(snap.tasks)}"
            + (
                f" | Note: {getattr(self.backend, 'last_error', '')}"
                if getattr(self.backend, "last_error", "")
                else ""
            )
        )
        return False

    def _on_wake_dsp(self, _btn):
        def _worker():
            with self.io_lock:
                if not self.backend:
                    return
                st, res = self.backend.pm_control(SOF_PM_OP_BOOT_DSP)
            GLib.idle_add(self._set_status, f"Wake DSP (st={st}): {res}")
            self._poll_once_Async(True)

        threading.Thread(target=_worker, daemon=True).start()

    def _on_toggle_hold_d0(self, btn: Gtk.ToggleButton):
        if self._suppress_hold_signal:
            return
        active = btn.get_active()

        def _worker():
            with self.io_lock:
                if not self.backend:
                    return
                op = SOF_PM_OP_WAKE_HOLD if active else SOF_PM_OP_RELEASE_HOLD
                st, res = self.backend.pm_control(op)
                self.holding_d0 = bool(res.get("fd_holding_d0", False))
            GLib.idle_add(
                self._set_status, f"PM Hold D0 = {self.holding_d0} (st={st}): {res}"
            )
            self._poll_once_Async(True)

        threading.Thread(target=_worker, daemon=True).start()

    def _on_rate_dropdown_changed(self, dd: Gtk.DropDown, _pspec):
        if self._suppress_rate_signal:
            return
        idx = dd.get_selected()
        if 0 <= idx < len(self.poll_rates):
            ms, _ = self.poll_rates[idx]
            self._on_set_poll_rate(None, ms)

    def _on_set_poll_rate(self, _btn, ms: int):
        if self.poll_timer_id:
            GLib.source_remove(self.poll_timer_id)
            self.poll_timer_id = None
        self.poll_interval_ms = ms
        if ms > 0:
            self.poll_timer_id = GLib.timeout_add(ms, self._on_poll_tick)
            self._set_status(f"Poll interval set to {ms} ms")
        else:
            self._set_status("Polling paused")

    def _on_export_png(self, _btn):
        out_path = "/tmp/softop_user_dashboard.png"
        render_user_dashboard_to_png(self.dashboard, out_path)
        self._set_status(f"Exported {out_path}")


def render_user_dashboard_to_png(
    dash_w,
    out_path: str,
    width: int = 1360,
    height: int = 840,
):
    if not out_path.endswith(".png"):
        out_path = f"{out_path}_dashboard.png"
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
    cr = cairo.Context(surf)
    dash_w.render_to_cairo(cr, float(width), float(height), None)
    surf.write_to_png(out_path)
    return out_path


def run_headless_render(args: argparse.Namespace) -> int:
    target = args.target
    if not target:
        probe = probe_local_sof_device()
        print(
            f"ERROR: {probe['reason']}. Pass --host HOST to connect to a remote sof_remote_server.",
            file=sys.stderr,
        )
        return 1

    backend = _build_backend_for_target(target, args.port)
    if not backend.connect():
        err = getattr(backend, "last_error", "")
        print(
            f"ERROR: Could not connect to {target}" + (f" ({err})" if err else ""),
            file=sys.stderr,
        )
        return 1

    is_ro = bool(getattr(backend, "is_read_only", False))
    try:
        dash_r = UserDashboardRenderer()
        if args.wake and not is_ro:
            backend.pm_control(SOF_PM_OP_WAKE_HOLD)
            backend.set_perf_measurement_state(2)

        snap = None
        valid_polls = 0
        for _ in range(6):
            s = backend.poll_telemetry(force_full=True, wake_dsp=(args.wake and not is_ro))
            if s.connected:
                if valid_polls == 0 and s.pm_runtime_active and s.fw_state == 7 and not is_ro:
                    backend.set_perf_measurement_state(2)
                snap = s
                dash_r.update_snapshot(snap)
                valid_polls += 1
            time.sleep(0.12)

        if not snap or not snap.connected:
            print(
                f"ERROR: Failed to retrieve telemetry snapshot from {target}",
                file=sys.stderr,
            )
            return 1

        out_file = render_user_dashboard_to_png(dash_r, args.render_png)
        hp_kb, hp_pwr_kb, hp_tot_kb = UserDashboardRenderer._sram_segment_metrics(snap.hpsram, 128.0)
        lp_kb, lp_pwr_kb, lp_tot_kb = UserDashboardRenderer._sram_segment_metrics(snap.lpsram, 64.0)
        print(
            f"Rendered {out_file} "
            f"(platform={snap.platform}, fw=v{snap.fw_version}, state={snap.fw_state} [{snap.fw_state_name}], "
            f"hpsram={hp_kb:.0f}/{hp_tot_kb:.0f} KB [pwr {hp_pwr_kb:.0f} KB], "
            f"lpsram={lp_kb:.0f}/{lp_tot_kb:.0f} KB [pwr {lp_pwr_kb:.0f} KB], "
            f"dram={snap.dram_used_kb:.0f}/{snap.dram_total_kb:.0f} KB, "
            f"tasks={len(snap.tasks)})"
        )
    finally:
        if args.wake and not is_ro:
            try:
                backend.pm_control(SOF_PM_OP_RELEASE_HOLD)
            except Exception:
                pass
        backend.close()
    return 0


class SofTopUserApp(Gtk.Application):
    def __init__(self, args: argparse.Namespace):
        super().__init__(
            application_id="org.thesofproject.SofTop",
            flags=Gio.ApplicationFlags.NON_UNIQUE,
        )
        self.args = args
        self.win = None

    def do_activate(self):
        if not self.win:
            self.win = SofTopUserWindow(self, self.args)
        self.win.present()


def main():
    ap = argparse.ArgumentParser(
        prog="sof-top",
        description="sof-top — SOF DSP User Monitor (Moving Core & SRAM/DRAM Memory Graphs + DSP Task List)",
    )
    ap.add_argument(
        "-H",
        "--host",
        default="",
        help="Remote host running sof_remote_server (omit to auto-connect locally)",
    )
    ap.add_argument("-p", "--port", type=int, default=9998, help="Remote TCP port (default: 9998)")
    ap.add_argument(
        "-l",
        "--local",
        nargs="?",
        const="auto",
        default="",
        help="Read telemetry directly from local host (DebugFS/SysFS read-only by default, or pass /dev/sof-dsp0)",
    )
    ap.add_argument("-i", "--interval", type=int, default=250, help="Poll interval in ms (default: 250)")
    ap.add_argument("-w", "--wake", action="store_true", help="Wake DSP on telemetry poll (TCP / CDEV only)")
    ap.add_argument("--render-png", default="", help="Render User Dashboard to PNG and exit")
    args = ap.parse_args()

    if args.host:
        args.initial_mode = "remote"
        args.target = f"{args.host}:{args.port}" if ":" not in args.host else args.host
    elif args.local:
        args.initial_mode = "local"
        args.target = f"local:{args.local}"
    else:
        probe = probe_local_sof_device()
        if probe["available"]:
            args.initial_mode = "local"
            args.target = "local:auto"
        else:
            args.initial_mode = "remote"
            args.target = ""

    if args.render_png:
        sys.exit(run_headless_render(args))

    app = SofTopUserApp(args)
    sys.exit(app.run(None))


if __name__ == "__main__":
    main()
