class TargetModeItem(GObject.Object):
    """Selection item for Local vs Remote backend mode dropdown."""

    def __init__(self, key: str, label: str, enabled: bool = True, tooltip: str = ""):
        super().__init__()
        self.key = key
        self.label = label
        self.enabled = enabled
        self.tooltip = tooltip


def _remote_history_path() -> str:
    cfg_root = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(cfg_root, "sof-top", "history.json")


def _load_remote_history(limit: int = 20) -> List[str]:
    path = _remote_history_path()
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        hosts = data.get("remote_hosts", []) if isinstance(data, dict) else []
        out: List[str] = []
        seen = set()
        for h in hosts:
            if isinstance(h, str):
                s = h.strip()
                if s and s not in seen and not (s == "local" or s.startswith("local:") or s.startswith("/")):
                    seen.add(s)
                    out.append(s)
                    if len(out) >= limit:
                        break
        return out
    except Exception:
        return []


def _record_remote_history(target: str, limit: int = 20) -> List[str]:
    s = (target or "").strip()
    if not s or s == "local" or s.startswith("local:") or s.startswith("/"):
        return _load_remote_history(limit)
    cur = _load_remote_history(limit)
    new_list = [s] + [h for h in cur if h != s]
    new_list = new_list[:limit]
    path = _remote_history_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.tmp.{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"remote_hosts": new_list}, f, indent=2)
        os.replace(tmp, path)
    except Exception:
        pass
    return new_list


