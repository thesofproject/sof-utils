def _parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    ap = argparse.ArgumentParser(
        prog="sof-top-cli",
        description="Command-line SOF DSP telemetry extractor (snapshots & live streams)",
    )
    ap.add_argument("-H", "--host", default="", help="Remote host[:port] running sof_remote_server")
    ap.add_argument("-p", "--port", type=int, default=SOF_NET_DEFAULT_PORT, help="Remote TCP port (default: 9998)")
    ap.add_argument(
        "-l",
        "--local",
        nargs="?",
        const="auto",
        default="",
        help="Read telemetry from local host (DebugFS/SysFS read-only default, or /dev/sof-dsp0)",
    )
    ap.add_argument("-w", "--wake", action="store_true", help="Wake/boot DSP before sampling (TCP / CDEV only)")
    ap.add_argument("--hold-d0", action="store_true", help="Hold D0i0 runtime PM across run and release on exit")
    ap.add_argument("--no-perf", action="store_true", help="Do not send IPC4 perf measurement enable")
    ap.add_argument("--warmup-ms", type=int, default=120, help="Warmup delta delay in ms before sample 0 (0 to skip; default: 120)")
    ap.add_argument("--snapshot", action="store_true", help="Capture 1 telemetry snapshot and exit (default)")
    ap.add_argument("--stream", action="store_true", help="Stream telemetry samples continuously until Ctrl+C / limit")
    ap.add_argument("-n", "--count", type=int, default=None, help="Sample count (1=snapshot, 0=infinite stream)")
    ap.add_argument("-i", "--interval", type=int, default=250, help="Stream poll interval in ms (default: 250)")
    ap.add_argument("-d", "--duration", type=float, default=0.0, help="Stop streaming after SEC seconds")
    ap.add_argument("--watch", action="store_true", help="ANSI live-refresh screen in TTY text stream mode")
    ap.add_argument(
        "-e",
        "--select",
        "--elements",
        action="append",
        default=[],
        help="Comma-separated sections or dot-paths to extract (e.g. cores,memory.hpsram,tasks.name)",
    )
    ap.add_argument("--filter", action="append", default=[], help="Filter list rows with KEY=VAL (repeatable)")
    ap.add_argument("--active-only", action="store_true", help="Omit idle/removed/zero-load entries in list sections")
    ap.add_argument("-f", "--format", choices=("text", "json", "jsonl", "kv"), default="text", help="Output format (default: text)")
    ap.add_argument("-r", "--raw", action="store_true", help="Emit bare scalar value(s) cleanly for shell scripting")
    ap.add_argument("-o", "--output", default="-", help="Output file path (default: '-' stdout)")
    ap.add_argument("--card-id", type=int, default=0, help="ALSA card index when selecting -e audio (default: 0)")
    ap.add_argument("--list-elements", action="store_true", help="List selectable elements/fields and exit")
    return ap.parse_args(argv)


def _resolve_target(args: argparse.Namespace) -> Tuple[Optional[str], Optional[str]]:
    if args.host:
        t = f"{args.host}:{args.port}" if ":" not in args.host else args.host
        return t, None
    if args.local:
        return f"local:{args.local}", None
    probe = probe_local_sof_device()
    if probe.get("available"):
        return "local:auto", None
    return None, str(probe.get("reason") or "No local SOF device detected")


def main(argv: Optional[Sequence[str]] = None) -> int:
    # Keep SIGPIPE ignored (Python default) so BrokenPipeError triggers finally cleanup

    args = _parse_args(argv)
    if args.list_elements:
        print_elements_catalog()
        return 0

    try:
        selectors = expand_selectors(args.select)
        for s in selectors:
            _validate_selector_root(s.split(".", 1)[0])
        filters = parse_filters(args.filter)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    target, probe_err = _resolve_target(args)
    if not target:
        msg = f"{probe_err}. Pass --host HOST[:PORT] or --local."
        if args.format in ("json", "jsonl"):
            print(json.dumps({"error": msg}), file=sys.stderr)
        else:
            print(f"ERROR: {msg}", file=sys.stderr)
        return 1

    # Determine sample count: --snapshot wins unless --stream or -n/-d specifies otherwise
    if args.snapshot:
        count = 1
    elif args.count is not None:
        count = max(0, args.count)
    elif args.stream or args.duration > 0.0:
        count = 0
    else:
        count = 1

    backend = build_backend_for_target(target, args.port)
    if not backend.connect():
        err = getattr(backend, "last_error", "") or "connection failed"
        msg = f"Failed to connect to {target}: {err}"
        if args.format in ("json", "jsonl"):
            print(json.dumps({"error": msg}), file=sys.stderr)
        else:
            print(f"ERROR: {msg}", file=sys.stderr)
        return 1

    out_fh = sys.stdout
    close_out = False
    if args.output and args.output != "-":
        out_fh = open(args.output, "w", encoding="utf-8")
        close_out = True

    stop_flag = False

    def _on_sig(_sig, _frame):
        nonlocal stop_flag
        stop_flag = True

    signal.signal(signal.SIGINT, _on_sig)
    signal.signal(signal.SIGTERM, _on_sig)

    is_ro = bool(getattr(backend, "is_read_only", False))
    held_d0 = False
    perf_done = False
    broken_pipe = False
    want_audio, want_probes = needs_rpc_extras(selectors)
    explicit_sections = bool(args.select) and not any(x in ("all", "full") for x in args.select)

    def _emit_error(msg: str) -> int:
        if args.format in ("json", "jsonl"):
            print(json.dumps({"error": msg}), file=sys.stderr)
        else:
            print(f"ERROR: {msg}", file=sys.stderr)
        return 1

    def _emit_poll_error(err_str: str) -> int:
        return _emit_error(f"Telemetry read failed for {target}: {err_str or 'disconnected'}")

    def _try_enable_perf(pm_active: bool, fw_state: int) -> bool:
        if perf_done or is_ro or args.no_perf or not (pm_active and fw_state == 7):
            return perf_done
        return backend.set_perf_measurement_state(2) == 0

    try:
        if (args.wake or args.hold_d0) and not is_ro:
            if args.wake:
                st_pm, pm_info = backend.pm_control(SOF_PM_OP_BOOT_DSP)
                if st_pm != 0:
                    return _emit_error(f"PM wake/boot failed for {target} (status={st_pm})")
                held_d0 = bool(pm_info.get("fd_holding_d0"))
                perf_done = _try_enable_perf(
                    bool(pm_info.get("pm_runtime_active")),
                    int(pm_info.get("fw_state", 0)),
                )
            if args.hold_d0 and not held_d0:
                st_pm, pm_info = backend.pm_control(SOF_PM_OP_WAKE_HOLD)
                if st_pm != 0 or not pm_info.get("fd_holding_d0"):
                    return _emit_error(
                        f"PM hold-d0 failed for {target} (status={st_pm}, holding_d0={bool(pm_info.get('fd_holding_d0'))})"
                    )
                held_d0 = True
                perf_done = _try_enable_perf(
                    bool(pm_info.get("pm_runtime_active")),
                    int(pm_info.get("fw_state", 0)),
                )

        # Warmup poll so tick-rate deltas populate even on a single snapshot
        if count == 1 and args.warmup_ms > 0:
            s0 = backend.poll_telemetry(force_full=True, wake_dsp=(args.wake and not is_ro))
            if not s0.connected:
                return _emit_poll_error(getattr(backend, "last_error", ""))
            perf_done = _try_enable_perf(bool(s0.pm_runtime_active), int(s0.fw_state))
            time.sleep(max(0.01, args.warmup_ms / 1000.0))

        interval_s = max(0.01, args.interval / 1000.0)
        start_wall = time.monotonic()
        sample_idx = 0
        collected_json: List[Dict[str, Any]] = []
        stream_json_array = args.format == "json" and count != 1 and count > 0
        effective_format = "jsonl" if (args.format == "json" and count == 0) else args.format

        def _write_output(text: str) -> bool:
            nonlocal broken_pipe, stop_flag
            try:
                out_fh.write(text)
                out_fh.flush()
                return True
            except BrokenPipeError:
                broken_pipe = True
                stop_flag = True
                return False

        while not stop_flag:
            if count > 0 and sample_idx >= count:
                break
            if args.duration > 0.0 and sample_idx > 0 and (time.monotonic() - start_wall) >= args.duration:
                break

            tick_start = time.monotonic()
            snap = backend.poll_telemetry(
                force_full=True,
                wake_dsp=((args.wake or args.hold_d0) and not is_ro),
            )
            if not snap.connected:
                if stream_json_array and collected_json and not broken_pipe:
                    _write_output(json.dumps(collected_json, indent=2) + "\n")
                return _emit_poll_error(getattr(backend, "last_error", ""))
            if not perf_done and not is_ro and not args.no_perf and snap.pm_runtime_active and snap.fw_state == 7:
                if backend.set_perf_measurement_state(2) == 0:
                    perf_done = True
                    settle_s = max(0.05, min(interval_s, 0.25))
                    time.sleep(settle_s)
                    if stop_flag:
                        break
                    snap = backend.poll_telemetry(
                        force_full=True,
                        wake_dsp=((args.wake or args.hold_d0) and not is_ro),
                    )
                    if not snap.connected:
                        if stream_json_array and collected_json and not broken_pipe:
                            _write_output(json.dumps(collected_json, indent=2) + "\n")
                        return _emit_poll_error(getattr(backend, "last_error", ""))

            audio_data = None
            probe_data = None
            if isinstance(backend, RemoteTcpBackend) and type(backend) is RemoteTcpBackend:
                if want_audio:
                    audio_data = backend.query_audio_graph(card_id=args.card_id)
                if want_probes:
                    st_avail, avail_pts = backend.query_probes(active_only=False)
                    st_act, act_pts = backend.query_probes(active_only=True)
                    probe_data = {
                        "available_status": st_avail,
                        "available": avail_pts,
                        "active_status": st_act,
                        "active": act_pts,
                    }
            else:
                if want_audio and audio_data is None:
                    audio_data = {"note": "audio graph requires remote TCP server (--host)"}
                if want_probes and probe_data is None:
                    probe_data = {"note": "probe query requires remote TCP server (--host)"}

            full_dict = snapshot_to_dict(
                snap,
                transport=getattr(backend, "transport_label", target),
                read_only=is_ro,
                last_error=getattr(backend, "last_error", ""),
                sample_index=sample_idx,
                audio_graph=audio_data,
                probes=probe_data,
            )
            filtered_full = apply_filters(full_dict, filters, active_only=args.active_only)
            filtered = apply_selection(filtered_full, selectors)

            if stream_json_array:
                collected_json.append(filtered)
            elif effective_format == "json":
                if not _write_output(json.dumps(filtered, indent=2) + "\n"):
                    break
            elif effective_format == "jsonl":
                if not _write_output(json.dumps(filtered, separators=(",", ":")) + "\n"):
                    break
            elif effective_format == "kv":
                prefix = "---\n" if (sample_idx > 0 and not args.raw) else ""
                if not _write_output(prefix + format_kv(filtered, raw=args.raw) + "\n"):
                    break
            else:
                if args.watch and out_fh.isatty():
                    prefix = "\033[2J\033[H"
                elif sample_idx > 0:
                    prefix = "\n"
                else:
                    prefix = ""
                if not _write_output(prefix + format_text(filtered, explicit_sections=explicit_sections, raw=args.raw) + "\n"):
                    break

            sample_idx += 1
            if count > 0 and sample_idx >= count:
                break
            elapsed = time.monotonic() - tick_start
            rem = interval_s - elapsed
            if args.duration > 0.0:
                rem = min(rem, args.duration - (time.monotonic() - start_wall))
            if rem > 0 and not stop_flag:
                time.sleep(rem)

        if stream_json_array and not broken_pipe:
            _write_output(json.dumps(collected_json, indent=2) + "\n")
    except BrokenPipeError:
        broken_pipe = True
    finally:
        if held_d0 and not is_ro:
            try:
                backend.pm_control(SOF_PM_OP_RELEASE_HOLD)
            except Exception:
                pass
        backend.close()
        if broken_pipe and out_fh is sys.stdout:
            try:
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
                os.close(devnull)
            except Exception:
                pass
        if close_out:
            try:
                out_fh.close()
            except BrokenPipeError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
