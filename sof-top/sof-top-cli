def _sram_to_dict(seg, bank_kb: float) -> Dict[str, Any]:
    used_kb, powered_kb, total_kb = compute_sram_segment_metrics(seg, bank_kb)
    d = asdict(seg)
    d["used_kb"] = round(used_kb, 3)
    d["powered_kb"] = round(powered_kb, 3)
    d["total_kb"] = round(total_kb, 3)
    d["used_pct"] = round((used_kb / total_kb) * 100.0, 2) if total_kb > 0 else 0.0
    return d


