def _normalize_audio_graph(audio_graph: Dict[str, Any]) -> Dict[str, Any]:
    """Convert tuple-keyed pcm_caps from query_audio_graph() into JSON-safe records."""
    out = dict(audio_graph)
    raw_caps = out.get("pcm_caps")
    if isinstance(raw_caps, dict):
        caps_list: List[Dict[str, Any]] = []
        for key, cap in raw_caps.items():
            rec = dict(cap) if isinstance(cap, dict) else {"value": cap}
            if isinstance(key, tuple) and len(key) == 3:
                rec["card_id"], rec["device_id"], rec["direction"] = key
            else:
                rec["key"] = str(key)
            caps_list.append(rec)
        out["pcm_caps"] = caps_list
    return out


def expand_selectors(raw_selectors: Sequence[str]) -> List[str]:
    """Expand presets, aliases, and comma-separated selectors cleanly in order."""
    if not raw_selectors:
        return list(ALL_TELEM_SECTIONS)

    tokens: List[str] = []
    for item in raw_selectors:
        for part in item.split(","):
            s = part.strip()
            if not s:
                continue
            if s == "all":
                tokens.extend(ALL_TELEM_SECTIONS)
            elif s == "full":
                tokens.extend(ALL_TELEM_SECTIONS)
                tokens.extend(RPC_EXTRA_SECTIONS)
            elif s in ELEMENT_ALIASES:
                tokens.extend(ELEMENT_ALIASES[s])
            elif "." in s:
                head, tail = s.split(".", 1)
                if head in ELEMENT_ALIASES and len(ELEMENT_ALIASES[head]) == 1:
                    tokens.append(f"{ELEMENT_ALIASES[head][0]}.{tail}")
                else:
                    tokens.append(s)
            else:
                tokens.append(s)

    seen = set()
    ordered: List[str] = []
    for tok in tokens:
        if tok not in seen:
            seen.add(tok)
            ordered.append(tok)
    return ordered or list(ALL_TELEM_SECTIONS)


def needs_rpc_extras(selectors: Sequence[str]) -> Tuple[bool, bool]:
    want_audio = any(s == "audio" or s.startswith("audio.") for s in selectors)
    want_probes = any(s == "probes" or s.startswith("probes.") for s in selectors)
    return want_audio, want_probes


def _validate_selector_root(root: str) -> None:
    valid = set(ALL_TELEM_SECTIONS) | set(RPC_EXTRA_SECTIONS)
    if root not in valid:
        raise ValueError(
            f"Unknown telemetry element '{root}'. Run --list-elements to inspect valid names."
        )


def _merge_selected_tree(dst: Any, src: Any, parts: Sequence[str]) -> Any:
    """Extract dotted path `parts` from `src` and merge recursively into `dst`."""
    if not parts:
        return src
    head = parts[0]
    tail = parts[1:]

    if isinstance(src, list):
        if dst is None:
            dst = [None] * len(src)
        out_list = list(dst)
        while len(out_list) < len(src):
            out_list.append(None)
        for idx, elem in enumerate(src):
            out_list[idx] = _merge_selected_tree(out_list[idx], elem, parts)
        return out_list

    if not isinstance(src, dict):
        return src

    if head not in src:
        raise ValueError(f"Unknown telemetry field '{head}'")

    cur_dst = dict(dst) if isinstance(dst, dict) else {}
    cur_dst[head] = _merge_selected_tree(cur_dst.get(head), src[head], tail)
    return cur_dst


def apply_selection(data: Dict[str, Any], selectors: Sequence[str]) -> Dict[str, Any]:
    """Project `data` onto requested selectors / dotted field paths."""
    result: Dict[str, Any] = {}
    for sel in selectors:
        parts = [p for p in sel.split(".") if p]
        if not parts:
            continue
        _validate_selector_root(parts[0])
        if parts[0] not in data:
            result[parts[0]] = None
            continue
        result = _merge_selected_tree(result, data, parts)
    return result


def parse_filters(filter_args: Sequence[str]) -> List[Tuple[str, str]]:
    filters: List[Tuple[str, str]] = []
    for expr in filter_args:
        if "=" not in expr:
            raise ValueError(f"Invalid --filter '{expr}' (expected KEY=VALUE)")
        k, v = expr.split("=", 1)
        k = k.strip()
        v = v.strip()
        if not k:
            raise ValueError(f"Empty key in --filter '{expr}'")
        filters.append((k, v))
    return filters


def _match_filter_value(actual: Any, target_str: str) -> bool:
    if isinstance(actual, bool):
        return str(actual).lower() == target_str.lower() or (
            actual and target_str == "1"
        ) or ((not actual) and target_str == "0")
    if isinstance(actual, int):
        try:
            return actual == int(target_str, 0)
        except ValueError:
            pass
    return str(actual).lower() == target_str.lower()


def _is_active_row(section: str, row: Dict[str, Any]) -> bool:
    if section == "cores":
        return bool(row.get("enabled", False)) or row.get("avg_kcps", 0) > 0 or row.get("tick_count", 0) > 0
    if section == "tasks":
        if row.get("status") in ("REMOVED", "GATED", "IDLE"):
            return False
        return (
            row.get("status") in ("RUNNING", "ACTIVE", "XRUN!", "CPC_VIOL")
            or row.get("cpu_pct", 0.0) > 0.0
            or row.get("avg_kcps", 0) > 0
        )
    if section == "components":
        return (not row.get("is_removed", False)) and (
            row.get("avg_kcps", 0) > 0 or row.get("iterations", 0) > 0
        )
    if section == "io_perf":
        return row.get("perf_usage", 0) > 0
    if section == "pipelines":
        return str(row.get("status_name", "")).upper() in ("RUNNING", "READY", "ACTIVE") or row.get("comp_count", 0) > 0
    if section == "gateways":
        return row.get("state", 0) > 0 or row.get("period_bytes", 0) > 0
    if section == "threads":
        if row.get("flags", 0) & 1:
            return False
        return row.get("cpu_load_pct", 0.0) > 0.0 or row.get("total_exec_kcycles", 0) > 0
    return True


def apply_filters(
    data: Dict[str, Any],
    filters: Sequence[Tuple[str, str]],
    active_only: bool = False,
) -> Dict[str, Any]:
    """Filter list sections by KEY=VALUE and/or --active-only cleanly."""
    if not filters and not active_only:
        return data

    out: Dict[str, Any] = {}
    for sec, val in data.items():
        if isinstance(val, list):
            kept = []
            for item in val:
                if not isinstance(item, dict):
                    kept.append(item)
                    continue
                if active_only and not _is_active_row(sec, item):
                    continue
                matched = True
                for fk, fv in filters:
                    if fk in item and not _match_filter_value(item[fk], fv):
                        matched = False
                        break
                if matched:
                    kept.append(item)
            out[sec] = kept
        else:
            out[sec] = val
    return out


def _flatten_kv(prefix: str, obj: Any, lines: List[Tuple[str, Any]]) -> None:
    if isinstance(obj, dict):
        for k, v in obj.items():
            sub = f"{prefix}.{k}" if prefix else str(k)
            _flatten_kv(sub, v, lines)
    elif isinstance(obj, list):
        if not obj:
            lines.append((prefix, "[]"))
        elif all(not isinstance(x, (dict, list)) for x in obj):
            lines.append((prefix, ",".join(str(x) for x in obj)))
        else:
            for idx, item in enumerate(obj):
                _flatten_kv(f"{prefix}[{idx}]", item, lines)
    else:
        lines.append((prefix, obj))


def _unwrap_single_scalar(obj: Any) -> Tuple[bool, Any]:
    """If `obj` holds a single scalar leaf through nested 1-key dicts, return (True, val)."""
    cur = obj
    while isinstance(cur, dict):
        if len(cur) != 1:
            return False, None
        cur = next(iter(cur.values()))
    if isinstance(cur, (list, dict)):
        return False, None
    return True, cur


def _format_cell(val: Any, key: str = "") -> str:
    if isinstance(val, float):
        if key == "timestamp":
            return f"{val:.3f}"
        return f"{val:.2f}"
    if isinstance(val, bool):
        return "yes" if val else "no"
    if isinstance(val, (list, dict)):
        return json.dumps(val, separators=(",", ":"))
    return str(val)


def _format_table(title: str, rows: List[Any], explicit: bool) -> List[str]:
    if not rows:
        return [f"[{title}] (0 entries)"] if explicit else []
    if not all(isinstance(r, dict) for r in rows):
        vals = ", ".join(_format_cell(r) for r in rows)
        return [f"[{title}] ({len(rows)}): {vals}"]

    cols: List[str] = []
    seen = set()
    for r in rows:
        for k in r.keys():
            if k not in seen:
                seen.add(k)
                cols.append(k)
    # Trim ultra-verbose nested lists in wide default view only if many columns exist
    rendered_rows: List[List[str]] = []
    for r in rows:
        rendered_rows.append([_format_cell(r.get(c, "")) for c in cols])

    widths = [len(c) for c in cols]
    for rvals in rendered_rows:
        for i, cell in enumerate(rvals):
            widths[i] = min(44, max(widths[i], len(cell)))

    def _fmt_row(vals: Sequence[str]) -> str:
        return "  ".join(
            (v[: widths[i] - 1] + "~" if len(v) > widths[i] else v).ljust(widths[i])
            for i, v in enumerate(vals)
        ).rstrip()

    out = [f"[{title}] ({len(rows)})"]
    out.append("  " + _fmt_row([c.upper() for c in cols]))
    out.append("  " + "-" * min(120, sum(widths) + 2 * max(0, len(widths) - 1)))
    for rvals in rendered_rows:
        out.append("  " + _fmt_row(rvals))
    return out


def _format_kv_block(title: str, mapping: Dict[str, Any]) -> List[str]:
    lines = [f"[{title}]"]
    flat: List[Tuple[str, Any]] = []
    _flatten_kv("", mapping, flat)
    if not flat:
        lines.append("  (empty)")
        return lines
    k_w = min(36, max(len(k) for k, _ in flat))
    for k, v in flat:
        lines.append(f"  {k:<{k_w}} : {_format_cell(v, key=k)}")
    return lines


def format_text(
    payload: Dict[str, Any],
    explicit_sections: bool,
    raw: bool = False,
) -> str:
    if raw:
        ok, scalar = _unwrap_single_scalar(payload)
        if ok:
            return str(scalar)
        kv_lines: List[Tuple[str, Any]] = []
        _flatten_kv("", payload, kv_lines)
        return "\n".join(str(v) for _, v in kv_lines)

    blocks: List[str] = []
    summ = payload.get("summary")
    if isinstance(summ, dict) and {"platform", "fw_state_name", "iso_time"}.issubset(summ.keys()):
        pm = "D0i0 ACTIVE" if summ.get("pm_runtime_active") else "D3 SLEEP"
        clk = summ.get("dsp_clock_hz", 0) / 1e6
        hdr = (
            f"=== SOF TELEMETRY [{summ.get('sample_index', 0)}] @ {summ.get('iso_time')} | "
            f"{summ.get('platform', 'unknown')} | {summ.get('fw_filename', '')} "
            f"v{summ.get('fw_version', '0.0.0.0')} ({summ.get('fw_state_name', '')}) | "
            f"{pm} @ {clk:.0f} MHz ==="
        )
        blocks.append(hdr)

    for sec, val in payload.items():
        if isinstance(val, list):
            lines = _format_table(sec.upper(), val, explicit=explicit_sections)
            if lines:
                blocks.append("\n".join(lines))
        elif isinstance(val, dict):
            # Render nested bundle/vregion lists cleanly if present
            list_subkeys = {k: v for k, v in val.items() if isinstance(v, list) and v and isinstance(v[0], dict)}
            if list_subkeys:
                scalar_sub = {k: v for k, v in val.items() if k not in list_subkeys}
                if scalar_sub:
                    blocks.append("\n".join(_format_kv_block(sec.upper(), scalar_sub)))
                for sk, sv in list_subkeys.items():
                    tlines = _format_table(f"{sec.upper()}.{sk.upper()}", sv, explicit=explicit_sections)
                    if tlines:
                        blocks.append("\n".join(tlines))
            else:
                blocks.append("\n".join(_format_kv_block(sec.upper(), val)))
        elif val is not None:
            blocks.append(f"{sec}: {_format_cell(val)}")

    return "\n\n".join(blocks)


def format_kv(payload: Dict[str, Any], raw: bool = False) -> str:
    if raw:
        ok, scalar = _unwrap_single_scalar(payload)
        if ok:
            return str(scalar)
    lines: List[Tuple[str, Any]] = []
    _flatten_kv("", payload, lines)
    out: List[str] = []
    for k, v in lines:
        if isinstance(v, (list, dict)):
            out.append(f"{k}={json.dumps(v, separators=(',', ':'))}")
        else:
            out.append(f"{k}={v}")
    return "\n".join(out)


